#!/usr/bin/env bash
#
# git-wt — git worktree helpers.
# https://github.com/AranBorkum/git-wt

set -euo pipefail

# Resolve the directory holding this script, following symlinks so the command
# works when linked onto PATH from somewhere else.
resolve_lib_dir() {
	local source="${BASH_SOURCE[0]}" dir
	while [ -L "$source" ]; do
		dir=$(cd -P "$(dirname "$source")" && pwd)
		source=$(readlink "$source")
		[[ "$source" != /* ]] && source="$dir/$source"
	done
	cd -P "$(dirname "$source")" && pwd
}

GIT_WT_ROOT=$(resolve_lib_dir)
readonly GIT_WT_ROOT

# Find the library directory. Checked in order: an explicit override, the
# in-repo layout, and the installed layout (bin/ and lib/git-wt/ under a
# shared prefix, as created by `make install`).
if [ -z "${GIT_WT_LIB:-}" ]; then
	for candidate in "$GIT_WT_ROOT/lib" "$GIT_WT_ROOT/../lib/git-wt"; do
		if [ -f "$candidate/version.sh" ]; then
			GIT_WT_LIB=$(cd "$candidate" && pwd)
			break
		fi
	done
fi

if [ -z "${GIT_WT_LIB:-}" ] || [ ! -f "$GIT_WT_LIB/version.sh" ]; then
	printf '❌ Error: could not locate the git-wt lib directory\n' >&2
	printf '   Set GIT_WT_LIB to the directory containing version.sh\n' >&2
	exit 1
fi
readonly GIT_WT_LIB

# shellcheck source=lib/version.sh
source "$GIT_WT_LIB/version.sh"
# shellcheck source=lib/output.sh
source "$GIT_WT_LIB/output.sh"
# shellcheck source=lib/git.sh
source "$GIT_WT_LIB/git.sh"
# shellcheck source=lib/create.sh
source "$GIT_WT_LIB/create.sh"
# shellcheck source=lib/delete.sh
source "$GIT_WT_LIB/delete.sh"
# shellcheck source=lib/list.sh
source "$GIT_WT_LIB/list.sh"

usage() {
	cat >&2 <<'EOF'
Usage: git wt <command> [options]

Commands:
  create <branch> [base]   Create a worktree for a branch
  delete [path-or-branch]  Remove a worktree (interactive with fzf)
  list                     List the repository's worktrees
  help                     Show this help
  version                  Print the version

Run `git wt <command> --help` for command-specific options.
EOF
}

main() {
	local command="${1:-help}"
	[ $# -gt 0 ] && shift

	case "$command" in
		create) create_worktree "$@" ;;
		delete) delete_worktree "$@" ;;
		list | ls) list_worktrees "$@" ;;
		help | -h | --help) usage ;;
		version | -v | --version) printf 'git-wt %s\n' "$GIT_WT_VERSION" ;;
		*)
			error "unknown command: $command"
			usage
			return 2
			;;
	esac
}

main "$@"
